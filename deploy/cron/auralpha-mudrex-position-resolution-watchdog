SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""

# Runs the Mudrex position-resolution read-only watchdog every 30 minutes.
# The runner writes timestamped JSON/log artifacts and keeps mutation/apply flags absent.
*/30 * * * * root cd /opt/auralpha/Backend/aurAlpha && /usr/bin/flock -n /var/lock/auralpha-mudrex-position-resolution-watchdog.lock bash -lc './scripts/checks/run-suggested-trades-mudrex-position-resolution-watchdog.sh' >> /var/log/auralpha-mudrex-position-resolution-watchdog.log 2>&1
