## Local development example only.
## For non-local deploys, use the environment-specific templates under environments/.
APP_ENV=localhost
NODE_ENV=development
PORT=3000

# App
APP_NAME=trading-apis
APP_SCHEMA=http
APP_HOST=localhost
APP_BANNER=true
APP_ROUTE_PREFIX=/api/v1
APP_API_KEY=change-me
APP_REQUIRE_API_KEY=true
APP_CORS_ORIGINS=

# Logging
LOG_LEVEL=info

# HTTP
HTTP_REQUEST_TIMEOUT_MS=10000

# Discovery
DISCOVERY_API_BASE_URL=http://localhost:8000/api/v1/discovery

# Auth
AUTH_ACCESS_TOKEN_SECRET=change-me-strong-random-secret
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_DAYS=7
AUTH_LOGIN_PROTECTION_ENABLED=true
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_IP_MAX_ATTEMPTS=20
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_LOCKOUT_MINUTES=15
AUTH_SEED_ENABLED=true
AUTH_SEED_EMAIL=admin@auralpha.com
AUTH_SEED_PASSWORD=Admin@123
AUTH_SEED_FULL_NAME=AurAlpha Admin

# Operational observability
OPS_AUTO_CAPTURE_ENABLED=true
OPS_CAPTURE_READ_REQUESTS=true
OPS_EMIT_FAILURE_ALERTS=true
OPS_EMIT_5XX_ALERTS=true
OPS_EMIT_4XX_MUTATION_ALERTS=true
OPS_FAILURE_ALERT_THROTTLE_MINUTES=15

# Activity export storage
ACTIVITY_EXPORT_STORAGE_MODE=filesystem
ACTIVITY_EXPORT_STORAGE_DIR=./storage/activity-exports

# Email delivery worker
EMAIL_DELIVERY_ENABLED=false
EMAIL_DELIVERY_POLL_INTERVAL_MS=5000
EMAIL_DELIVERY_BATCH_SIZE=10
EMAIL_DELIVERY_MAX_ATTEMPTS=5
EMAIL_DELIVERY_STALE_MINUTES=10
EMAIL_PROVIDER=smtp
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_FROM=
EMAIL_SMTP_REPLY_TO=
EMAIL_RESEND_API_KEY=
EMAIL_RESEND_API_BASE_URL=https://api.resend.com
EMAIL_RESEND_FROM=
EMAIL_RESEND_REPLY_TO=

# WhatsApp delivery worker
WHATSAPP_DELIVERY_ENABLED=false
WHATSAPP_DELIVERY_PROVIDER=twilio
WHATSAPP_DELIVERY_POLL_INTERVAL_MS=5000
WHATSAPP_DELIVERY_BATCH_SIZE=10
WHATSAPP_DELIVERY_MAX_ATTEMPTS=5
WHATSAPP_DELIVERY_STALE_MINUTES=10
WHATSAPP_TWILIO_ACCOUNT_SID=
WHATSAPP_TWILIO_AUTH_TOKEN=
WHATSAPP_TWILIO_FROM=
WHATSAPP_TWILIO_API_BASE_URL=https://api.twilio.com/2010-04-01

# Scheduler worker connection
SCHEDULER_EXECUTION_MODE=queue
SCHEDULER_SYSTEM_USER_ID=system
SCHEDULER_WORKER_SCHEMA=http
SCHEDULER_WORKER_HOST=localhost
SCHEDULER_WORKER_PORT=3001
SCHEDULER_WORKER_BASE_URL=http://localhost:3001
DISCOVERY_SCHEDULER_SECRET=change-me-strong-random-secret

# Suggested trades live-auto rollout
SUGGESTED_TRADES_ROLLOUT_ENABLED=true
SUGGESTED_TRADES_LIVE_AUTO_ENABLED=false
SUGGESTED_TRADES_LIVE_AUTO_EXECUTION_ENABLED=false
SUGGESTED_TRADES_LIVE_AUTO_MUDREX_ENABLED=true
SUGGESTED_TRADES_LIVE_AUTO_DELTA_EXCHANGE_ENABLED=true
SUGGESTED_TRADES_LIVE_AUTO_REQUIRE_FIXED_ROUTING=false
SUGGESTED_TRADES_LIVE_AUTO_USER_ALLOWLIST=
SUGGESTED_TRADES_LIVE_AUTO_BROKER_ALLOWLIST=
SUGGESTED_TRADES_LIVE_AUTO_SHADOW_BROKER_ALLOWLIST=
SUGGESTED_TRADES_PROTECTION_REPAIR_MUDREX_ENABLED=true
SUGGESTED_TRADES_PROTECTION_REPAIR_DELTA_EXCHANGE_ENABLED=true

# Paper order background execution
PAPER_ORDER_EXECUTION_BACKGROUND_ENABLED=true
PAPER_ORDER_EXECUTION_POLL_INTERVAL_MS=30000
PAPER_ORDER_EXECUTION_BATCH_SIZE=200

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_AUTO_START=true
WORKER_HEARTBEAT_KEY=scheduler:worker:heartbeat
EMAIL_WORKER_HEARTBEAT_KEY=email:worker:heartbeat
WHATSAPP_WORKER_HEARTBEAT_KEY=whatsapp:worker:heartbeat

# Security
BROKER_ACCOUNT_SECRETS_KEY=change-me-strong-random-secret

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_NAME=auralpha
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Postgres (Strategy + Backtests)
PG_DB_ENABLED=true
PG_DB_HOST=127.0.0.1
PG_DB_PORT=5432
PG_DB_USERNAME=apple
PG_DB_PASSWORD=
PG_DB_NAME=auralpha
PG_DB_SSL=false
PG_DB_LOGGING=false
