APP_ENV=production
NODE_ENV=production
PORT=3000

# App
APP_NAME=trading-apis
APP_SCHEMA=https
APP_HOST=
APP_BANNER=false
APP_ROUTE_PREFIX=/api/v1
APP_API_KEY=
APP_REQUIRE_API_KEY=true
APP_CORS_ORIGINS=

# Logging
LOG_LEVEL=info

# HTTP
HTTP_REQUEST_TIMEOUT_MS=10000

# Activity export storage
ACTIVITY_EXPORT_STORAGE_MODE=filesystem
ACTIVITY_EXPORT_STORAGE_DIR=/app/storage/activity-exports

# Auth
AUTH_ACCESS_TOKEN_SECRET=
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_DAYS=7
AUTH_LOGIN_PROTECTION_ENABLED=true
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_IP_MAX_ATTEMPTS=20
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_LOCKOUT_MINUTES=15
AUTH_SEED_ENABLED=false
AUTH_SEED_EMAIL=
AUTH_SEED_PASSWORD=
AUTH_SEED_FULL_NAME=

# Production bootstrap seed
PRODUCTION_BOOTSTRAP_SEED_ENABLED=false
PRODUCTION_BOOTSTRAP_ADMIN_EMAIL=admin@auralpha.com
PRODUCTION_BOOTSTRAP_ADMIN_PASSWORD=
PRODUCTION_BOOTSTRAP_ADMIN_FULL_NAME=AurAlpha Admin
PRODUCTION_BOOTSTRAP_ADMIN_RESET_PASSWORD=false
PRODUCTION_BOOTSTRAP_TIMEZONE=Asia/Kolkata
PRODUCTION_BOOTSTRAP_BROKER_KEYS=mudrex,delta_exchange
PRODUCTION_BOOTSTRAP_BROKER_KEY=
PRODUCTION_BOOTSTRAP_BROKER_ACCOUNT_SCOPES=system,admin
PRODUCTION_BOOTSTRAP_BROKER_ACCOUNT_STATUS=Idle
PRODUCTION_BOOTSTRAP_BROKER_ACCOUNT_MODE=live
PRODUCTION_BOOTSTRAP_MUDREX_BASE_URL=https://trade.mudrex.com
PRODUCTION_BOOTSTRAP_DELTA_BASE_URL=https://api.india.delta.exchange
PRODUCTION_BOOTSTRAP_STRATEGY_TEMPLATE_NAME=Bootstrap Momentum Guard

# Discovery
DISCOVERY_API_BASE_URL=

# Scheduler worker connection
SCHEDULER_EXECUTION_MODE=queue
SCHEDULER_SYSTEM_USER_ID=system
SCHEDULER_WORKER_SCHEMA=http
SCHEDULER_WORKER_HOST=
SCHEDULER_WORKER_PORT=3001
SCHEDULER_WORKER_BASE_URL=
DISCOVERY_SCHEDULER_SECRET=

# Broker canary monitor
BROKER_CANARY_MONITOR_ENABLED=true
BROKER_CANARY_MONITOR_LOOKBACK_HOURS=720
BROKER_CANARY_MONITOR_MAX_SUBMISSIONS=100
BROKER_CANARY_MONITOR_SNAPSHOT_STALE_AFTER_MS=900000

# Redis
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_AUTO_START=false
WORKER_HEARTBEAT_KEY=scheduler:worker:heartbeat

# Security
BROKER_ACCOUNT_SECRETS_KEY=

# Database
DB_HOST=
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Postgres (Strategy + Backtests)
PG_DB_ENABLED=true
PG_DB_HOST=
PG_DB_PORT=5432
PG_DB_USERNAME=
PG_DB_PASSWORD=
PG_DB_NAME=
PG_DB_SSL=true
PG_DB_LOGGING=false
